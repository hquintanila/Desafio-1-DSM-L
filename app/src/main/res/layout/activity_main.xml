<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menú Principal - Desafío 1"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Botón Ejercicio 1 (Morado) -->
        <Button
            android:id="@+id/btnEjercicio1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 1: Promedio de Estudiante"
            android:backgroundTint="@color/opcion1Purple"
            android:textColor="@color/white"
            android:layout_marginBottom="12dp" />

        <!-- Botón Ejercicio 2 (Celeste) -->
        <Button
            android:id="@+id/btnEjercicio2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 2: Calculadora de Salario Neto"
            android:backgroundTint="@color/opcion2Cyan"
            android:textColor="@color/white"
            android:layout_marginBottom="12dp" />

        <!-- Botón Ejercicio 3 (Amarillo) -->
        <Button
            android:id="@+id/btnEjercicio3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 3: Calculadora Básica"
            android:backgroundTint="@color/opcion3Yellow"
            android:textColor="@color/black"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>